# Initial UT configuration delta; merge and inspect the resulting .config.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_DEFAULT_SECURITY="apparmor"

# Maintained kernel backports: compile KPTI support; Sony forces it off by default.
# Preserve qualified baseline: do not credit unaudited bootloader entropy.
# CONFIG_RANDOM_TRUST_BOOTLOADER is not set
# Preserve the existing conntrack diagnostic interface across changed defaults.
CONFIG_NF_CONNTRACK_PROCFS=y

CONFIG_UNMAP_KERNEL_AT_EL0=y

# The release userdata root image is packed with mksquashfs -comp xz.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
